\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces \textbf  {2D Projection of Calibrated Boundaries on Good Predictors.} Per host envelope boundary comparison for Staphylococcus projected onto the 2D plane of two discriminative functional features (transcriptional\_activator vs. annealing). Left (Collapsed 1D): Linear boundary defined by equal weight mean nonconformity. Centre (Radial): Smooth angular kernel boundary ($\kappa =4.0$), closely enveloping the nonconformity cluster. Right (Strip): Piecewise constant staircase boundary enforcing local monotonicity ($w=2$).}}{35}{figure.5.4}\protected@file@percent }
\newlabel{fig: staph both good}{{5.4}{35}{\textbf {2D Projection of Calibrated Boundaries on Good Predictors.} Per host envelope boundary comparison for Staphylococcus projected onto the 2D plane of two discriminative functional features (transcriptional\_activator vs. annealing). Left (Collapsed 1D): Linear boundary defined by equal weight mean nonconformity. Centre (Radial): Smooth angular kernel boundary ($\kappa =4.0$), closely enveloping the nonconformity cluster. Right (Strip): Piecewise constant staircase boundary enforcing local monotonicity ($w=2$)}{figure.5.4}{}}
\newlabel{fig: staph both good@cref}{{[figure][4][5]5.4}{[1][35][]35}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.5}{\ignorespaces \textbf  {2D Projection of Calibrated Boundaries on One Good and One Bad Predictor}. Per host envelope boundary comparison for Staphylococcus projected onto one informative and one uninformative functional feature (transcriptional\_activator vs. reductase). When one dimension contains non infector noise, Collapsed 1D's linear projection dilutes the strong signal across both axes. The Strip envelope isolates the noisy axis to wide marginal bounds along the horizontal strip, while the Radial envelope expands outward along the uninformative ray.}}{36}{figure.5.5}\protected@file@percent }
\newlabel{fig: staph 1 good 1 bad}{{5.5}{36}{\textbf {2D Projection of Calibrated Boundaries on One Good and One Bad Predictor}. Per host envelope boundary comparison for Staphylococcus projected onto one informative and one uninformative functional feature (transcriptional\_activator vs. reductase). When one dimension contains non infector noise, Collapsed 1D's linear projection dilutes the strong signal across both axes. The Strip envelope isolates the noisy axis to wide marginal bounds along the horizontal strip, while the Radial envelope expands outward along the uninformative ray}{figure.5.5}{}}
\newlabel{fig: staph 1 good 1 bad@cref}{{[figure][5][5]5.5}{[1][35][]36}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.6}{\ignorespaces \textbf  {Clustermap of Predicted Phage Host Interactions (Collapsed 1D).} Binary prediction matrix evaluated across all $N_{\text  {test}} = 3{,}944$ test phages (rows) and $54$ candidate host genera (columns) under the Collapsed 1D method ($1-\alpha =0.90$). Dark pixels denote host inclusion in the conformal prediction set $C(s)$. Left sidebars indicate ground-truth Gram phenotype (blue: Gram-negative, orange: Gram-positive) and top true host genera. }}{37}{figure.5.6}\protected@file@percent }
\newlabel{fig:phage_host_clustermap_collapsed}{{5.6}{37}{\textbf {Clustermap of Predicted Phage Host Interactions (Collapsed 1D).} Binary prediction matrix evaluated across all $N_{\text {test}} = 3{,}944$ test phages (rows) and $54$ candidate host genera (columns) under the Collapsed 1D method ($1-\alpha =0.90$). Dark pixels denote host inclusion in the conformal prediction set $C(s)$. Left sidebars indicate ground-truth Gram phenotype (blue: Gram-negative, orange: Gram-positive) and top true host genera}{figure.5.6}{}}
