   "source": [
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "\n",
    "model_folder = Path(\"../Data/random_pc_r5_da_2_bal\")\n",
    "pkl_files = sorted(model_folder.glob(\"all_preds_*.pkl\"))\n",
    "\n",
    "all_hosts_per_file = {}\n",
    "for f in pkl_files:\n",
    "    df = pd.read_pickle(f)\n",
    "    hosts = sorted(set(col.rsplit(\"_\", 1)[0] for col in df.columns))\n",
    "    all_hosts_per_file[f.name] = hosts\n",
    "\n",
    "# All unique hosts across ALL files\n",
    "all_hosts_union = sorted(set(h for hosts in all_hosts_per_file.values() for h in hosts))\n",
    "print(f\"Total unique hosts across all r5 files: {len(all_hosts_union)}\")\n",
    "print(all_hosts_union)\n",
    "\n",
    "# Check if all files have the same hosts\n",
    "host_sets = [tuple(v) for v in all_hosts_per_file.values()]\n",
    "print(f\"\\nAre all files consistent? {len(set(host_sets)) == 1}\")\n",
    "if len(set(host_sets)) > 1:\n",
    "    for fname, hosts in all_hosts_per_file.items():\n",
    "        print(f\"  {fname}: {len(hosts)} hosts\")"
